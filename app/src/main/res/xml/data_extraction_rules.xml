<?xml version="1.0" encoding="utf-8"?><!--
   数据提取规则（API 31+ 的云备份与设备间传输）。

   承载 Keystore 密文的 prefs 不参与备份 / 传输：Keystore 密钥不可迁移，
   恢复后密文无法解密，会静默变成空串。跨设备迁移请使用应用内的配置导出 / 导入。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="izukijs_ai.xml" />
        <exclude domain="sharedpref" path="izukijs_ocr.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="izukijs_ai.xml" />
        <exclude domain="sharedpref" path="izukijs_ocr.xml" />
    </device-transfer>
</data-extraction-rules>
