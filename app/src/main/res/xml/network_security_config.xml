<?xml version="1.0" encoding="utf-8"?><!--
   网络安全配置。

   AI（baseUrl）与在线 OCR（endpoint）允许用户自定义地址，常见于局域网 Ollama、
   自建识别服务等 http:// 场景。Android 9（API 28）起默认禁止明文流量，
   这里显式放开明文；HTTPS 仍使用系统信任锚做证书校验，不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
