    <string name="perm_status_authorized">Authorized</string>
    <string name="perm_capture_desc">Authorize once to record continuously, providing unlimited frames for screenshot / image matching / OCR.</string>
    <string name="perm_capture_tip">Recommended together with Bluetooth HID / Accessibility / Shizuku to close the see-and-act loop.</string>
    <string name="perm_action_authorize_start">Authorize and start</string>
    <string name="perm_action_stop_recording">Stop recording</string>
    <string name="perm_hid_desc">Inject input with absolute coordinates through external HID hardware (tablet dongle), identical to real hardware.</string>
    <string name="perm_hid_pro_1">Identical to real hardware events, hardest to detect</string>
    <string name="perm_hid_pro_2">Absolute coordinates, precise taps and swipes</string>
    <string name="perm_hid_con_1">Requires external HID hardware, less portable</string>
    <string name="perm_hid_con_2">No screenshot or node tree support</string>
    <string name="perm_action_connect">Connect</string>
    <string name="perm_accessibility_desc">Inject gestures and read the node tree through the accessibility service. No extra install, best compatibility.</string>
    <string name="perm_accessibility_pro_1">No extra install, works out of the box</string>
    <string name="perm_accessibility_pro_2">Reads the node tree for precise selector targeting</string>
    <string name="perm_accessibility_con_1">Easier to detect by risk control</string>
    <string name="perm_accessibility_con_2">No screenshot below API 30; limited key / text input</string>
    <string name="perm_action_open">Enable</string>
    <string name="perm_shizuku_desc">Inject input, take screenshots and run Shell with ADB privileges through Shizuku. Most capable.</string>
    <string name="perm_shizuku_pro_1">Most complete: gesture / key / text / screenshot / Shell</string>
    <string name="perm_shizuku_pro_2">High privileges without Root</string>
    <string name="perm_shizuku_con_1">Requires Shizuku running; restart after reboot</string>
    <string name="perm_shizuku_con_2">Stops working when disconnected</string>
    <string name="perm_action_shizuku_not_running">Shizuku not running</string>
    <string name="perm_action_authorize">Authorize</string>
    <string name="perm_root_desc">Call system capabilities directly with Root privileges, similar in power to Shizuku.</string>
    <string name="perm_root_pro_1">Highest privileges, comparable to Shizuku</string>
    <string name="perm_root_pro_2">Run Shell and system-level operations directly</string>
    <string name="perm_root_con_1">Device must be rooted, high barrier</string>
    <string name="perm_root_con_2">Excessive privileges, greatest risk</string>
    <string name="perm_action_detect_root">Detect Root</string>
    <string name="perm_action_revoke">Revoke</string>
    <string name="perm_floating_title">Floating window</string>
    <string name="perm_floating_desc">Show the control bar and debug panel as floating windows to run scripts anytime and visualize the node tree and OCR coordinates.</string>
    <string name="perm_floating_tip">Recommended with any control permission to run and debug scripts easily.</string>
