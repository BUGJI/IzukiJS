    <!-- Permissions -->
    <string name="perm_tip">Tip: you can revoke unnecessary permissions while a script runs to lower the risk of detection. Pick the permissions your current script actually needs based on the pros and cons below.</string>
    <string name="perm_screen_capture">Screen capture</string>
    <string name="perm_status_recording">Recording</string>
    <string name="perm_status_off">Off</string>
    <string name="perm_status_on">On</string>
    <string name="perm_status_service_stopped">Service not running</string>
    <string name="perm_status_authorized">Authorized</string>
    <string name="perm_capture_desc">Continuously output screen frames from system recording, as the image source for screenshot / image matching / color finding / OCR.</string>
    <string name="perm_capture_pro_1">Continuously outputs screen frames for screenshot / image matching / color finding / OCR</string>
    <string name="perm_capture_pro_2">Stays on after a single authorization, no repeated prompts</string>
    <string name="perm_capture_con_1">The recording state is exposed to the recorded app as an event, risking detection and your account</string>
    <string name="perm_capture_con_2">Screens with FLAG_SECURE can only be captured as black</string>
    <string name="perm_capture_tip">Recommended together with Bluetooth HID / Accessibility / Shizuku to close the see-and-act loop.</string>
    <string name="perm_action_authorize_start">Authorize and start</string>
    <string name="perm_action_stop_recording">Stop recording</string>
    <string name="perm_hid_desc">Inject gestures / keys / text with absolute coordinates through external HID hardware (tablet dongle).</string>
    <string name="perm_hid_pro_1">Injects gestures / keys / text with absolute coordinates</string>
    <string name="perm_hid_pro_2">Input is identical to real hardware events, hard to flag by risk control</string>
    <string name="perm_hid_con_1">Requires external HID hardware (tablet dongle)</string>
    <string name="perm_action_connect">Connect</string>
    <string name="perm_action_manage">Manage device</string>
    <string name="perm_accessibility_desc">Inject gestures / text and read the node tree and global actions through the accessibility service.</string>
    <string name="perm_accessibility_pro_1">No extra install, enabled with the system accessibility service</string>
    <string name="perm_accessibility_pro_2">Supports node tree reading and selector targeting (the only backend behind selector.*)</string>
    <string name="perm_accessibility_con_1">Apps can enumerate enabled accessibility services; regular users are the most likely to be flagged</string>
    <string name="perm_accessibility_con_2">No screenshot below API 30; limited key / text input</string>
    <string name="perm_action_open">Enable</string>
    <string name="perm_shizuku_desc">Inject gestures / keys / text, take screenshots and run Shell with ADB privileges through Shizuku.</string>
    <string name="perm_shizuku_pro_1">Provides gesture / key / text / screenshot / Shell</string>
    <string name="perm_shizuku_pro_2">ADB-level privileges without Root</string>
    <string name="perm_shizuku_con_1">Requires Shizuku running; restart after reboot</string>
    <string name="perm_shizuku_con_2">Stops working when disconnected</string>
    <string name="perm_action_shizuku_not_running">Shizuku not running</string>
    <string name="perm_action_authorize">Authorize</string>
    <string name="perm_root_desc">Inject gestures / keys / text, take screenshots, run Shell and system-level operations with Root privileges.</string>
    <string name="perm_root_pro_1">Provides gesture / key / text / screenshot / Shell and system-level capabilities</string>
    <string name="perm_root_pro_2">Rooted users can manage the environment and detection themselves, hard to flag by risk control</string>
    <string name="perm_root_con_1">Device must be rooted, high barrier</string>
    <string name="perm_action_detect_root">Detect Root</string>
    <string name="perm_action_revoke">Revoke</string>
    <string name="perm_floating_title">Floating window</string>
    <string name="perm_floating_desc">Show the control bar and debug panel as floating windows to run scripts anytime and visualize the node tree and OCR coordinates.</string>
    <string name="perm_floating_tip">Recommended with any control permission to run and debug scripts easily.</string>
    <string name="perm_floating_control">Show floating control bar</string>
    <string name="perm_floating_debug">Show layout / OCR debug panel</string>
    <string name="perm_floating_debug_desc">Automatically hides while capturing layout / OCR so it is not captured on screen.</string>
    <string name="perm_overlay_needed">Grant the \"Display over other apps\" permission in system settings.</string>
