    <string name="perm_usage_desc">Read app usage records to determine the foreground app and usage time.</string>
    <string name="perm_notify_title">Notification access</string>
    <string name="perm_notify_desc">Read notification title / text / package (read-only; no tap or reply) to capture verification codes or message triggers.</string>
    <string name="perm_applist_title">App list</string>
    <string name="perm_applist_desc">Allow scripts to enumerate installed apps (required on Android 11+).</string>
