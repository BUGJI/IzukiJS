# 本地调试产物（截图 / 日志 / 临时补丁 / 抓包），不要提交。
# 根目录只放调试文件，临时脚本建议改放 debug/，避免和项目配置混在一起。
/*.js
/*.json
/*.xml
/*.py
/*.txt
/*.log
/*.png
/*.patch
/debug/
/scratch/
# 仍允许常见的根目录项目配置，避免被上面的通配误伤
!/package.json
!/package-lock.json
!/renovate.json
!/.eslintrc.json
!/eslint.config.js
!/prettier.config.js
!/commitlint.config.js
